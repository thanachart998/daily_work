{
  "name": "worklog-local",
  "version": "1.0.0",
  "private": true,
  "description": "เว็บบันทึกงานประจำวันและสรุปผลงานรายเดือน (ใช้งานแบบ Local)",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node --experimental-sqlite --no-warnings node_modules/tsx/dist/cli.mjs server/index.ts",
    "build": "vite build",
    "package": "node scripts/package.mjs",
    "dev": "concurrently -k -n api,web -c blue,green \"node --experimental-sqlite --no-warnings node_modules/tsx/dist/cli.mjs watch server/index.ts\" \"vite\"",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-sqlite --no-warnings node_modules/vitest/vitest.mjs run",
    "seed": "node --experimental-sqlite --no-warnings node_modules/tsx/dist/cli.mjs server/scripts/seed.ts",
    "init-db": "node --experimental-sqlite --no-warnings node_modules/tsx/dist/cli.mjs server/scripts/init-db.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anuphan": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai-looped": "^5.3.0",
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fontsource/sarabun": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "dayjs": "^1.11.23",
    "express": "^4.22.3",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "postcss": "^8.5.32",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
